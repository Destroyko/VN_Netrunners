# Godot 4: кэш импорта и временные файлы
.godot/
/android/
*.translation

# Настройки экспорта содержат локальные пути и ключи
export.cfg
export_presets.cfg

# Сборки
/builds/
/export/

# Отчёты инструментов (генерируются заново)
/tools/out/

# Прочее
.DS_Store
Thumbs.db
mono_crash.*.json

# Python-кэш от инструментов в tools/
__pycache__/

# Блокауты: .blend и рендеры собираются скриптом за секунды, истина — в tools/blockout/
# Звёздочка, а не сама папка: иначе исключения ниже не работают — git не достаёт
# файл из игнорируемой директории
/assets/_source/blockout/*
# ...кроме детальной сцены и эталонных кадров: обстановку расставляли руками,
# скриптом она не пересобирается, и потерять её нельзя (docs/art/ai-pipeline.md, 5.10)
!/assets/_source/blockout/apartment_detail.blend
# ...и библиотека материалов: она собирается скриптом, но нужна под рукой
# в Blender через Append, а не после пересборки
!/assets/_source/blockout/palette_materials.blend

# Пробы портретов: внешность персонажей не утверждена (ai-pipeline.md, 10.4),
# это черновики подбора стиля
/assets/_source/portraits/

# Журналы сессий и снимки «здесь баг» (F9): локальные, у каждого свои
/bugreports/
