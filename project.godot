; Файл настроек проекта. Правится в редакторе Godot (Проект → Настройки проекта),
; но числа и пути важны для вывода рендеров — менять осознанно.

config_version=5

[application]

config/name="VN-netrunners"
config/description="Сюжетный симулятор жизни хакера + визуальная новелла. Рабочее название."
config/version="0.0.1"
run/main_scene="res://src/ui/boot/boot_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Порядок важен: GameState и EventBus не зависят ни от кого, остальные опираются на них.
GameState="*res://src/autoload/game_state.gd"
EventBus="*res://src/autoload/event_bus.gd"
Rng="*res://src/autoload/rng.gd"
Clock="*res://src/autoload/clock.gd"
HeatManager="*res://src/autoload/heat_manager.gd"
HackManager="*res://src/autoload/hack_manager.gd"
NeedsManager="*res://src/autoload/needs_manager.gd"
EconomyManager="*res://src/autoload/economy_manager.gd"
QuestManager="*res://src/autoload/quest_manager.gd"
NewsManager="*res://src/autoload/news_manager.gd"
BackgroundManager="*res://src/autoload/background_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"
DialogueManager="*res://src/autoload/dialogue_manager.gd"
; Окно диалогов поверх любой сцены (новелла): только показ, логика — DialogueManager.
DialogueOverlay="*res://src/ui/dialogue/dialogue_overlay.gd"
PhoneOverlay="*res://src/ui/phone/phone_overlay.gd"
InventoryOverlay="*res://src/ui/inventory/inventory_overlay.gd"
; Экран своего ПК при выключении, загрузке и установке системы: только показ, правила — PcPower.
BootOverlay="*res://src/ui/boot/boot_overlay.gd"
; Заметный трейс поверх всего: полоска вверху, рамка и таймер в последнюю минуту (TraceAlarm).
TraceOverlay="*res://src/ui/trace/trace_overlay.gd"
TriggerManager="*res://src/autoload/trigger_manager.gd"
; Инфраструктура, а не игровая система: держит пропорции окна при ручном ресайзе.
WindowGuard="*res://src/autoload/window_guard.gd"
; Инструмент разработки: журнал сессии и снимок «здесь баг» по F9 (docs/tech/testing.md).
SessionLog="*res://src/debug/session_log.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

; Интерфейс живёт в пикселях экрана: больше разрешение — больше места, а не крупнее кнопки
; (docs/tech/resolution.md). Фоны — рендеры из Blender, пиксель-арта в игре нет.
; Базовый размер = минимальное комфортное разрешение.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
; disabled: 1 единица = 1 пиксель. fractional: иначе масштаб интерфейса 125% и 150%
; округлился бы до 100%.
window/stretch/mode="disabled"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]

; Linear: графика — рендеры и картинки, а не пиксель-арт (docs/art/style-guide.md).
; Nearest дал бы ступеньки на плавных переходах при масштабировании под экран.
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

theme/custom_font="res://assets/fonts/IBMPlexSans-Variable.ttf"
timers/tooltip_delay_sec=0.2
