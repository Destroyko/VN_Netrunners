; Файл настроек проекта. Правится в редакторе Godot (Проект → Настройки проекта),
; но числа и пути важны для пиксельной картинки — менять осознанно.

config_version=5

[application]

config/name="VN-netrunners"
config/description="Сюжетный симулятор жизни хакера + визуальная новелла. Рабочее название."
config/version="0.0.1"
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Порядок важен: GameState и EventBus не зависят ни от кого, остальные опираются на них.
GameState="*res://src/autoload/game_state.gd"
EventBus="*res://src/autoload/event_bus.gd"
Rng="*res://src/autoload/rng.gd"
Clock="*res://src/autoload/clock.gd"
HeatManager="*res://src/autoload/heat_manager.gd"
; Инфраструктура, а не игровая система: держит пропорции окна при ручном ресайзе.
WindowGuard="*res://src/autoload/window_guard.gd"
; Инструмент разработки: журнал сессии и снимок «здесь баг» по F9 (docs/tech/testing.md).
SessionLog="*res://src/debug/session_log.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

; Интерфейс живёт в пикселях экрана: больше разрешение — больше места, а не крупнее кнопки
; (docs/tech/resolution.md). Пиксельный арт масштабируется отдельно, внутри своих сцен.
; Базовый размер = минимальное комфортное разрешение.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
; disabled: 1 единица = 1 пиксель. fractional: иначе масштаб интерфейса 125% и 150%
; округлился бы до 100%.
window/stretch/mode="disabled"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]

; Nearest — иначе пиксели размываются.
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
